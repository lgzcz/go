# 网页标题
VITE_TITLE = "如形の主页"
# 网页关键词
VITE_KEYWORDS = "如形の小站, 个人主页, Vue3, Vite, TypeScript, Tailwind CSS, 博客, 文档, 工具, website, generator, tools, 如影随形, 如形, Vue3, Nodejs, 主页"
# 网页描述
VITE_DESCRIPTION = "如形的个人主页，提供美观的网页，如博客、文档和各种工具。"
# 网页图标
VITE_FAVICON = "/favicon.ico"

## 你需要部署Umami 再填写这些配置
# Umami 统计脚本地址
VITE_UMAMI_SCRIPT = "https://stai.rusin7.com/script.js"
# Umami 统计网站 ID
VITE_UMAMI_WEBSITE_ID = "9b4cefbe-e127-432f-8d77-91ffc1fabd25"

## 引入Font Awesome 图标库 fa6.dashgame.com
VITE_ICON_LIBRARY = "https://jsd.liiiu.cn/gh/fortawesome/font-awesome@7.3.0/css/all.min.css"

## 引入字体库 // 如需修改字体同步去 style.less 文件修改Body内容
VITE_FONT_LIBRARY = "https://dash.amlg.top/public/lwsw.min.css"

# 网页内显示的名称 // 页脚也会同步显示
VITE_APP_USER_NAME = "如形の小站"
# 网页内显示的头像
VITE_APP_PROFILE_IMAGE_URL = "/favicon.ico"

## 页脚的备案信息 // 如果不填写则不显示 // 移动端不显示公安备案号
# 应用 ICP 备案号
VITE_APP_ICP_NUMBER = "萌 ICP 备 20268884 号"
# 应用公安备案号
VITE_APP_POLICE_NUMBER = ""

